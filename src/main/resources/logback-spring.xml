<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Mantém o log padrão do Spring Boot no console -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Só no Docker/Kubernetes (onde o Loki está no ar): envia os logs para o Loki,
         que são visualizados no Grafana junto com o traceId -->
    <springProfile name="docker">
        <springProperty name="appName" source="spring.application.name"/>
        <springProperty name="lokiUrl" source="loki.url" defaultValue="http://localhost:3100/loki/api/v1/push"/>

        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
            </http>
            <labels>
                app = ${appName}
                level = %level
            </labels>
            <message>
                <pattern>traceId=%X{traceId:-} %-5level %logger{36} - %msg %ex</pattern>
            </message>
        </appender>

        <root level="INFO">
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
